# NOTHING IN THIS FILE IS REQUIRED - AND MOST OF IT NOW LIVES IN THE APP.
#
# The public web address, outgoing email (SMTP_*), allowed website addresses (CORS_ORIGIN)
# and KCB addresses (KCB_*) are set under Settings in the web app (admin) - no file editing,
# no restart. The lines below still work as a FALLBACK for older installs; a value saved in
# Settings always wins.
#
# NOTHING IN THIS FILE IS REQUIRED.
#
# You do not need to copy this to .env. The first time the server starts it
# creates backend/.env by itself, with its own unique JWT_SECRET, ENCRYPTION_KEY,
# PAYMENT_WEBHOOK_SECRET and LEAD_INTAKE_SECRET. This file only documents the
# OPTIONAL settings you can add to backend/.env if you need them.
#
# Back up backend/.env along with backend/data/ - ENCRYPTION_KEY unlocks the SMS
# and payment-gateway credentials saved in the database.
#
# CORS: leave CORS_ORIGIN unset and the app works from this machine and from
# anything on the shop's network (phones, tablets). Only set it if the frontend
# is hosted on a public address; then ONLY the origins you list are allowed.
#
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/urban_trends.db
# JWT_SECRET=            # auto-generated on first run
JWT_EXPIRES_IN=8h
# ACCESS_TOKEN_EXPIRES_IN takes over from JWT_EXPIRES_IN above (kept for
# reference — no longer read). Short-lived on purpose: a leaked access
# token is only useful for a few minutes. Staying logged in past that goes
# through a refresh token instead — long-lived, but revocable and rotated
# on every use (see DOCUMENTATION.md).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
# Used to encrypt connected-store (Shopify/WooCommerce) credentials at rest
# in the database. Any long random string works, same as JWT_SECRET — use a
# DIFFERENT value than JWT_SECRET, and keep it out of source control. Losing
# this key means existing connected stores need their credentials re-entered.
# ENCRYPTION_KEY=         # auto-generated on first run
# Comma-separated list — add your phone's LAN origin here to test on mobile
# alongside your regular browser, e.g.:
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.42:5173
# CORS_ORIGIN=https://pos.example.com

# --- Legacy single-store Shopify integration (still supported) ---
# As of Jan 1 2026, Shopify no longer lets you create a custom app and copy
# its Admin API token straight out of Admin > Settings > Apps > Develop apps —
# new apps are created in the Shopify Dev Dashboard instead. These env vars
# still work if you already have a token from an app created before the
# cutover. For anything new, use Settings > Income sources in the app instead
# — just paste the shop domain, Client ID, and Client secret from your Dev
# Dashboard app there and click Connect; no callback URL or public HTTPS
# endpoint is needed (it uses the client credentials grant, a plain
# server-to-server exchange), and it supports multiple stores including
# WooCommerce, rather than a single hardcoded one here.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01

# --- Email backups (optional) ---
# When set, a fresh backup is emailed as an attachment every 24 hours, in
# addition to the local backups already kept in data/backups/ every 6h.
# Leave SMTP_HOST blank to disable — no email is sent, and the app runs
# exactly as if this section didn't exist.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where backup emails are sent. Required (alongside SMTP_HOST) to enable email backups.
BACKUP_EMAIL_TO=

# --- Payment reconciliation webhooks (KCB / M-Pesa) ---
# Shared secret checked against the X-Webhook-Secret header on inbound
# calls to /api/integrations/payments/{kcb,mpesa}/webhook — set the SAME
# value on whichever side configures the webhook (KCB developer portal /
# Safaricom Daraja). Leave unset and those two endpoints simply reject
# every request with 503 rather than silently accepting unauthenticated
# payment notifications — this is NOT optional to leave blank once you
# actually wire up KCB/M-Pesa access.
# PAYMENT_WEBHOOK_SECRET=  # auto-generated on first run

# Required to register M-Pesa C2B Validation/Confirmation URLs with
# Safaricom (Settings → Payment gateways → M-Pesa → "Register webhook
# URLs"). Must be a PUBLIC HTTPS URL Safaricom can actually reach —
# Safaricom cannot call localhost. While developing, run `ngrok http 4000`
# (or similar) and paste the https:// tunnel URL here; in production, your
# real domain. No trailing slash.
# APP_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
APP_BASE_URL=

# KCB (Buni) — only needed if your actual Buni product's base URL/token
# path differ from the best-effort defaults in config/kcb.js (see the
# honesty note at the top of that file). Leave unset to use the defaults.
# KCB_API_BASE_URL_SANDBOX=
# KCB_API_BASE_URL_PRODUCTION=
# KCB_TOKEN_PATH=


# --- Customer SMS (Zettatel) ---
# Optional: you can instead save these under Settings -> Customer SMS (stored
# encrypted in the database; the database copy wins if both are set).
# SMS is OFF until you enable it there, after sending a test message.
# ZETTATEL_USER_ID=
# ZETTATEL_PASSWORD=
# ZETTATEL_SENDER_ID=
# ZETTATEL_SEND_URL=https://portal.zettatel.com/SMSApi/send

# --- Website-form lead intake ---
# Shared secret your form plugin sends in the X-Intake-Secret header when it
# POSTs to /api/integrations/leads/intake. Required: with no secret set, intake
# is OFF (it fails closed) rather than open to anyone. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LEAD_INTAKE_SECRET=

# --- Encrypted backups ---
# Backups that are EMAILED are compressed and encrypted (AES-256-GCM) so a copy sitting in an inbox is unreadable.
# BACKUP_PASSPHRASE: pick a long phrase (12+ characters) that only you know and keep it in your password manager.
# If it is not set, the key is derived from ENCRYPTION_KEY instead, so backups are never sent in the clear.
# Open one (a "trial restore") with:  node scripts/restore-backup.js path/to/backup.db.gz.enc
# BACKUP_PASSPHRASE=

# --- Proxies in front of the app ---
# 1 = Railway only (default). Set to 2 if you put Cloudflare in front of Railway, so the real visitor address is used
# for rate limits and lockout alerts instead of Cloudflare's.
# TRUST_PROXY_HOPS=1
