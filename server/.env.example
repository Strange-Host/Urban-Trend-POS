# Copy to .env for local development. Never commit the real one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/urban_trends
PORT=3000
# Set to true only for a public Postgres connection string; Railway's private network does not need it.
DATABASE_SSL=false
LOG_LEVEL=info

# Scrambles order references (UT-XXXXXXXX). At least 32 random characters. Needed from phase 3, when references are issued.
# NEVER change it once references exist: the app refuses to start issuing with a different key.
ORDER_REF_KEY=
# Nightly integrity check, at this hour in shop time (East Africa Time). Set INTEGRITY_JOB=false to turn it off.
INTEGRITY_JOB=true
INTEGRITY_HOUR=2

# How long a login lasts, in hours.
SESSION_HOURS=12

# Sign-in attempts (password, PIN, unlock) allowed per address per window. Per-account lockout applies on top.
# LOGIN_RATE_LIMIT_MAX=20
# LOGIN_RATE_LIMIT_MINUTES=15
# Number of proxies in front of the server. 1 on Railway; leave at 1 or every visitor shares the proxy's address.
# TRUST_PROXY_HOPS=1
# Browser origins allowed to call the API with the sign-in cookie (comma separated), e.g. https://pos.example.com,http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# 'strict' when the screens and the API share a site (app.example.com + api.example.com, or localhost). Use 'none' only if they are on
# unrelated domains; the cookie then needs HTTPS. If every page reload signs you out, this is the first thing to check.
# REFRESH_COOKIE_SAMESITE=strict
