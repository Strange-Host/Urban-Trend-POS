# NOT REQUIRED. With no .env at all, the app talks to the backend on the same
# machine that served the page (port 4000) - including from a phone or tablet on
# the same WiFi. Only set this if the backend is somewhere else:
#
# VITE_API_URL=https://api.example.com/api

# --- New server (Phase C of the legacy-first upgrade plan) --------------------------------------------------------
# Leave off to keep every screen on the legacy backend. Set to true to point the same screens at the new
# PostgreSQL/TypeScript server through the adapters in src/api/adapters. Calls the new server cannot do yet fail with a
# clear "not available on the new server yet" message; they never fall back to the legacy backend.
# VITE_USE_NEW_SERVER=true
# VITE_NEW_API_URL=http://localhost:3000/api
